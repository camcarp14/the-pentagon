{
  "name": "the-pentagon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @app/shell run dev",
    "build": "npm --workspace @app/shell run build",
    "smoke": "node scripts/smoke.mjs",
    "preview": "npm --workspace @app/shell run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run test && npm run build",
    "themes": "node packages/design/gen-themes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@netlify/blobs": "^8.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dompurify": "^3.4.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "vitest": "^2.1.9"
  }
}
