# ═══════════════════════════════════════════════════════════════════════════
# THE PENTAGON — environment
#
# There was no file like this. The only env documentation was docs/DEPLOY.md,
# which was written when this was a three-tool app called "Command Center" and
# omitted SHOPIFY_*, GOOGLE_PLACES_KEY, HUNTER_API_KEY, FIRECRAWL_API_KEY and
# TELEGRAM_*. This list was rebuilt by reading every env access in the repo.
#
# Copy to `.env` for local dev. Set the server-side half in Netlify (Site
# configuration → Environment variables). NEVER commit a filled-in copy.
#
# ── The VITE_ rule ─────────────────────────────────────────────────────────
# Anything prefixed VITE_ is compiled into the PUBLIC browser bundle. Treat
# every one of them as published. Secrets go in the un-prefixed, server-only
# section below and are reached through /.netlify/functions/*.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Client (public — safe to expose) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Client: the AI Business agent (a SEPARATE Supabase project) ───────────
# These do NOT point at VITE_SUPABASE_URL's project. The agent gets its own
# project on purpose: it holds spend and strategy, and a compromise of it has to
# stop there rather than reaching the Pentagon's data. That isolation is the
# whole reason the AI Business tab carries its own Supabase client instead of
# importing the shared one.
#
# Pointing both at the same project silently defeats it — every query still
# succeeds, because the table names are free in either project, so nothing looks
# wrong. The tab therefore refuses to boot when it detects the two hosts match,
# and /.netlify/functions/env-check reports agent_project_is_separate: false.
#
# The key must be an anon/publishable key (a legacy JWT with role 'anon', or an
# `sb_publishable_…` key). A service key pasted here works perfectly: it bypasses
# RLS, every query succeeds, and it is compiled into the public browser bundle
# where anyone can read and rewrite the whole business with it. That is the
# failure that looks like success, so the tab classifies the key rather than
# merely checking it is set, and refuses anything it cannot call public.
VITE_AGENT_SUPABASE_URL=https://your-agent-project.supabase.co
VITE_AGENT_SUPABASE_ANON_KEY=

# ─── Client, DEV ONLY (never set these in Netlify) ──────────────────────────
# Each of these is read behind `import.meta.env.DEV`, which Vite replaces with
# the literal `false` at build time — so the whole expression folds away and the
# value is never emitted into dist. Verified by building with canary values and
# grepping the output: 0 occurrences.
#
# This deliberately is NOT a `window.location.hostname === "localhost"` check.
# That is evaluated at RUNTIME, so the minifier has to keep both branches and
# the key ships as a readable string literal in public JS — the code just never
# uses it. Deployed traffic goes through /.netlify/functions/* and needs none of
# these. Still: do not set them in Netlify.
VITE_ANTHROPIC_API_KEY=
VITE_GOOGLE_PLACES_KEY=
VITE_HUNTER_API_KEY=
VITE_FIRECRAWL_API_KEY=

# ─── Server: Anthropic ─────────────────────────────────────────────────────
# Used by netlify/functions/{claude,claude-stream,audit-lead,parse-job,parse-resume,tailor}.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Server: OpenAI ────────────────────────────────────────────────────────
# Used by netlify/functions/{claude,claude-stream} when the request names a GPT
# model — the same two proxies serve both vendors and pick by model id (see
# netlify/functions/lib/openai.mjs). Optional: leave it blank and every Claude
# model keeps working exactly as before; picking a GPT model in Settings then
# returns a 503 that names this variable rather than failing obscurely.
# Set it in Netlify → Site configuration → Environment variables, then redeploy.
OPENAI_API_KEY=

# ─── Server: Supabase ──────────────────────────────────────────────────────
# Functions prefer the VITE_ names and fall back to these, so the client and the
# functions always verify tokens against the SAME project. Keeping them aligned
# is what stops the "valid token, function says not signed in" class of bug.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role BYPASSES RLS. Only scan-cron.mjs uses it. Without it that cron is
# a loud no-op. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The single operator address Runway's functions authorize against.
ALLOWED_EMAIL=
# The immutable auth.users.id for that same operator. Find it in Supabase's
# Authentication users list; privileged functions require both values.
ALLOWED_USER_ID=
# Secret salt for the public free-audit rate limiter. Generate 32 random bytes;
# set this in Netlify Functions scope only, never in VITE_ variables.
AUDIT_RATE_LIMIT_SALT=

# ─── Server: Gmail (Clarify outreach) ──────────────────────────────────────
# send-email.js, read-emails.js, check-replies.js, and the Desk's approve path
# (queue-execute.mjs). The send itself now lives in _shared/gmail.cjs, which
# DOES guard: a missing var throws GMAIL_ENV_MISSING naming the exact vars
# rather than surfacing as an opaque token-exchange failure. read-emails.js and
# check-replies.js still have their own unguarded copies of the token exchange.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── Server: Shopify (ZTS) ─────────────────────────────────────────────────
# Used by shopify-publish.js (blog-article WRITE) and zts-ingest.mjs (READ).
#
# SCOPES. The token today carries write_content only. zts-ingest needs
# read_orders and read_products added to the same custom app; until they are,
# every ingestion pass fails loudly with SHOPIFY_FORBIDDEN and writes nothing.
#
# SHOPIFY_STORE. The live store's real myshopify host is 1xgjj4-eh.myshopify.com
# — NOT zero-to-secure.myshopify.com, which an older comment in shopify-publish.js
# guessed at. zerotosecure.com is the custom storefront domain and is not a valid
# value here. If the deployed value is the guessed one, blog publishing is
# already broken. A bare handle is accepted and normalised to <handle>.myshopify.com.
SHOPIFY_STORE=1xgjj4-eh.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_BLOG_ID=
# Optional. Shopify retires API versions on a rolling ~12-month window; set this
# when the built-in default ages out and calls start 400ing.
SHOPIFY_API_VERSION=
# Optional, comma-separated. Orders from these addresses are classified as tests,
# not revenue. Both lifetime orders on this store were self-placed and refunded,
# so leaving this empty overstates the business by exactly 100%.
ZTS_STAFF_EMAILS=

# ─── Server: prospecting (Clarify) ─────────────────────────────────────────
# prospect-proxy.js. No missing-var guard — an empty key is passed upstream and
# surfaces as a 401 from the provider.
GOOGLE_PLACES_KEY=
HUNTER_API_KEY=
FIRECRAWL_API_KEY=

# ─── Server: Telegram (Macro alerts) ───────────────────────────────────────
# watch-snapshot.mjs. Properly guarded: if either is missing, alerting silently
# disables rather than erroring.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
